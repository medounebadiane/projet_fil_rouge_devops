# Modèle de configuration - à copier en .env puis à compléter
#   Windows (PowerShell) : copy .env.example .env
#   Linux / Git Bash     : cp .env.example .env
# Le fichier .env contient les vrais secrets : il ne doit JAMAIS être publié sur GitHub.

# Nom affiché dans le bandeau de bienvenue des deux pages
APP_AUTEUR=MEDOUNE BADIANE

# Les deux choix du vote
OPTION_A=Cats
OPTION_B=Dogs

# Ports ouverts sur la machine (page de vote et page des résultats)
VOTE_PORT=8080
RESULT_PORT=8081

# Adresse ouverte par le bouton « Voir les résultats » (à adapter si RESULT_PORT change)
RESULT_URL=http://localhost:8081

# Base de données PostgreSQL
POSTGRES_USER=postgres
POSTGRES_DB=postgres
# Obligatoire : choisissez votre propre mot de passe dans .env
POSTGRES_PASSWORD=changez_moi
